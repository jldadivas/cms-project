# SQLite database file used by Payload
DATABASE_URL=file:./expo.db

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Set this to http://<YOUR_WIFI_IPV4>:3000 for access from other devices.
# Used to configure CORS, format links and more. No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Origins allowed by the optional FastAPI telemetry backend.
# Add http://<YOUR_WIFI_IPV4>:3000 when browser code calls the API on port 8080.
CORS_ORIGINS=http://localhost:3000

# Optional reachable base URL for the Raspberry Pi IoT API (no trailing slash).
# Leave blank to use clearly labeled simulated data on /sensor-dashboard.
NEXT_PUBLIC_IOT_API_BASE_URL=

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE
